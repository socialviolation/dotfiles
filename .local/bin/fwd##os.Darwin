#!/usr/bin/env bash
#
# fwd — ssh port forwarding for oauth callbacks on a remote dev host.
#
# The problem: you are ssh'd into another machine, an mcp server or cli wants
# you to authorise, and it prints an https url whose redirect_uri points at a
# localhost port on the *remote* box. Opening that url in the mac browser sends
# the callback to the mac's localhost, where nothing is listening.
#
# fwd forwards those ports back to the remote host so the callback lands.
#
#   fwd                  read the url from the clipboard (no pasting required)
#   fwd "<url>"          take the url as an argument (must be quoted)
#   fwd 3000 8080        forward bare ports
#
# Behaviours:
#
#   - Ports are extracted from a url three ways: loopback hosts
#     (localhost/127.0.0.1/0.0.0.0/[::1] followed by :port), *port= query
#     params (port, proxyPort, callback_port), and bare numeric arguments.
#     Only loopback hosts match, so the auth server's own :443 is never
#     forwarded. Ports are deduped and range checked.
#   - %3A is decoded first, so ports url-encoded inside redirect_uri are found.
#   - All whitespace is stripped from each argument before parsing. Copying a
#     url out of a terminal wraps it across lines, and those newlines otherwise
#     break both the url and the port match.
#   - The repaired single-line url is written back to the clipboard, ready to
#     paste into the browser.
#   - Forwarding is torn down on ctrl-c or esc.
#
# Environment:
#
#   FWD_SSH_TARGET   required, the ssh target to forward to, e.g. nick@omarchy.
#                    Set in ~/.zshrc.user alongside CLIPSSH_HOST. There is no
#                    default; an unset var is an error rather than a silent
#                    fallback to the wrong machine.
#
# Requires tailscale to be up: the target is resolved over the tailnet by
# MagicDNS (`omarchy` -> 100.x.y.z), not by ~/.ssh/config or public dns, so
# `tailscale status` should list the host before this will connect. pbcopy and
# pbpaste make this mac-only, hence the ##os.Darwin yadm alternate.
#
set -euo pipefail

host="${FWD_SSH_TARGET:-}"

if [[ -z $host ]]; then
    echo "fwd: FWD_SSH_TARGET is not set (e.g. export FWD_SSH_TARGET=user@host)" >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    clip=$(pbpaste)
    if [[ -z ${clip//[[:space:]]/} ]]; then
        echo "usage: fwd [PORT|URL...]   (no args reads the url from your clipboard)" >&2
        exit 1
    fi
    set -- "$clip"
fi

ports=()

add_port() {
    local port=$1
    if [[ ! $port =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        echo "fwd: invalid port: $port" >&2
        exit 1
    fi
    local seen
    for seen in ${ports[@]+"${ports[@]}"}; do
        [[ $seen == "$port" ]] && return
    done
    ports+=("$port")
}

url=""

for arg in "$@"; do
    arg=${arg//[[:space:]]/}

    if [[ $arg =~ ^[0-9]+$ ]]; then
        add_port "$arg"
        continue
    fi

    [[ -z $url ]] && url=$arg

    decoded=${arg//%3A/:}
    decoded=${decoded//%3a/:}
    matches=$(
        grep -oiE '(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\]):[0-9]{1,5}' <<<"$decoded" || true
        grep -oE '[?&]([A-Za-z]+[_-])?[Pp]ort=[0-9]{1,5}' <<<"$decoded" || true
        grep -oE '[?&][A-Za-z]+Port=[0-9]{1,5}' <<<"$decoded" || true
    )
    found=$(grep -oE '[0-9]+$' <<<"$matches" || true)

    if [[ -z $found ]]; then
        echo "fwd: no localhost or callback ports found in: $arg" >&2
        exit 1
    fi

    while read -r port; do
        add_port "$port"
    done <<<"$found"
done

forwards=()
for port in "${ports[@]}"; do
    forwards+=(-L "${port}:localhost:${port}")
done

ssh -N \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=3 \
    "${forwards[@]}" "$host" &
ssh_pid=$!

cleanup() {
    trap - EXIT INT TERM
    kill "$ssh_pid" 2>/dev/null || true
    wait "$ssh_pid" 2>/dev/null || true
    echo "fwd: closed"
}
trap cleanup EXIT INT TERM

for port in "${ports[@]}"; do
    echo "fwd: localhost:${port} -> ${host}:${port}"
done

if [[ -n $url ]]; then
    printf '%s' "$url" | pbcopy
    echo "fwd: url copied to clipboard (${#url} chars)"
fi
echo "fwd: ctrl-c or esc to close"

if [[ -t 0 ]]; then
    while kill -0 "$ssh_pid" 2>/dev/null; do
        if read -rsn1 -t 0.5 key && [[ $key == $'\e' ]]; then
            break
        fi
    done
else
    wait "$ssh_pid"
fi
