#!/bin/bash

# Remove dotfiles-specific files from home after yadm checkout
# This prevents these files from cluttering other projects

if [ -f "$HOME/.claude/commands/merge.md" ]; then
    echo "🧹 Removing dotfiles-specific Claude command: merge"
    rm -f "$HOME/.claude/commands/merge.md"
fi

if [ -f "$HOME/.claude/commands/sync.md" ]; then
    echo "🧹 Removing dotfiles-specific Claude command: sync"
    rm -f "$HOME/.claude/commands/sync.md"
fi

if [ -f "$HOME/sync" ]; then
    echo "🧹 Removing dotfiles sync script from home"
    rm -f "$HOME/sync"
fi

# Apply pulled config: install any newly-declared herdr plugins, then reload herdr
if [ -f "$HOME/.config/yadm/herdr-plugins.sh" ]; then
    bash "$HOME/.config/yadm/herdr-plugins.sh"
fi

if [ -S "$HOME/.config/herdr/herdr.sock" ]; then
    echo "🔄 Reloading herdr config"
    PATH="$HOME/.local/bin:$PATH" herdr server reload-config > /dev/null || true
fi
